---
// Bandeau gris "More questions?" + icône heptagone vert "?" — répété à
// l'identique en bas de plusieurs pages use-cases (private-networks,
// single-engine, value-added-services).
import Icon from './Icon.astro';
---

<section class="section more-questions">
  <div class="container more-questions__inner">
    <h2 data-reveal="left">More questions?</h2>
    <div class="more-questions__icon" data-reveal="right">
      <Icon name="question-heptagon-green" size={140} />
    </div>
  </div>
</section>

<style>
  .more-questions {
    padding-block: var(--space-12);
    background: var(--color-section-gray);
  }

  .more-questions__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .more-questions__inner h2 {
    font-size: 42.667px;
  }

  @media (max-width: 620px) {
    .more-questions__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-6);
    }
  }
</style>
