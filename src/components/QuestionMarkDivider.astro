---
// Bandeau plein vert avec une icône heptagone noir "?" — pure séparateur
// visuel (sans texte) utilisé avant les blocs FAQ sur plusieurs pages
// use-cases (cf 3rd-party-api-exposure, private-networks).
---

<div class="question-divider" aria-hidden="true">
  <svg viewBox="0 0 100 100" width="90" height="90">
    <polygon
      points="50,2 90,16 100,55 73,90 27,90 0,55 10,16"
      fill="#0a0a0f"
    />
    <text x="50" y="70" text-anchor="middle" font-family="Poppins, sans-serif" font-weight="800" font-size="60" fill="var(--color-green)">?</text>
  </svg>
</div>

<style>
  .question-divider {
    background: var(--color-green);
    display: flex;
    justify-content: center;
    align-items: center;
    padding-block: var(--space-10);
  }
</style>
