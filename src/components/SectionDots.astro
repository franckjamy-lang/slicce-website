---
// Séparateur décoratif à carrés (repris du site actuel), un seul en vert.
interface Props {
  count?: 3 | 4;
  active?: number;
  // Permet à une page d'élargir l'espacement d'une occurrence précise (voir
  // technology.astro) sans changer la marge par défaut partagée par tout le
  // site.
  class?: string;
}
const { count = 4, active = 0, class: className } = Astro.props;
const dots = Array.from({ length: count }, (_, i) => i);
---

<div class:list={['section-dots', className]} aria-hidden="true">
  {dots.map((i) => (
    <span class:list={['section-dots__dot', { 'is-active': i === active }]}></span>
  ))}
</div>

<style>
  .section-dots {
    display: flex;
    justify-content: center;
    gap: var(--space-1);
    margin-block: var(--space-8);
  }

  .section-dots__dot {
    width: 12px;
    height: 12px;
    background: #1c1c1c;
  }

  .section-dots__dot.is-active {
    background: var(--color-green);
  }
</style>
