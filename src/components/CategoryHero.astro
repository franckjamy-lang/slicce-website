---
// Bandeau noir épuré utilisé en tête des pages "catégorie" (listing de
// produits : API Exposure Functions, Interworking Functions, etc.) —
// même traitement visuel que le hero des pages produit individuelles
// (ProductLayout), mais sans les sections qui suivent (features, specs...).
// A ne pas confondre avec PageBanner (bandeau avec skyline en fond), conçu
// pour les pages utilitaires (Catalog, Articles, Blog).
interface Props {
  title: string;
  description: string;
  icon?: string;
}
const { title, description, icon } = Astro.props;
---

<section class="category-hero">
  <div class="category-hero__inner">
    <div class="category-hero__text" data-reveal="left">
      <h1>{title}</h1>
      <p>{description}</p>
    </div>
    {
      icon && (
        <div class="category-hero__icon" data-reveal="right">
          <img src={icon} alt="" width="560" height="448" loading="lazy" />
        </div>
      )
    }
  </div>
</section>

<style>
  /* Hauteur fixe (comme sur le site original, ~360px sur toutes les pages
     sans distinction) : le texte est centré verticalement dedans plutôt
     que de dicter la hauteur du bandeau via son propre padding. */
  .category-hero {
    position: relative;
    background: var(--color-black-soft);
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: 360px;
  }

  /* Texte + pod dans la même rangée flex (au lieu d'un pod positionné en
     absolu, ancré au bord de la fenêtre indépendamment du texte) : les
     deux se partagent l'espace sans jamais se chevaucher, quelle que
     soit la largeur de fenêtre. */
  .category-hero__inner {
    position: relative;
    width: 100%;
    max-width: 1600px;
    margin-inline: auto;
    padding-inline: var(--space-6);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
  }

  .category-hero__text {
    flex: 1 1 0;
    min-width: 0;
    max-width: 1100px;
  }

  .category-hero h1 {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 56px;
    color: var(--color-green);
    margin-bottom: var(--space-4);
  }

  .category-hero__text p {
    font-family: var(--font-heading);
    font-size: 18.667px;
    font-weight: 400;
    color: var(--color-off-white);
    line-height: 1.5;
  }

  /* Le pod colle au haut et au bas du bandeau (comme sur le site
     original) : sa taille grossit/rétrécit avec la hauteur du bandeau,
     qui varie selon la longueur du titre/texte de chaque page. */
  .category-hero__icon {
    flex: 0 0 auto;
    align-self: stretch;
    max-width: 450px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .category-hero__icon img {
    max-height: 100%;
    max-width: 100%;
    width: auto;
    height: auto;
  }

  @media (max-width: 1200px) {
    .category-hero__icon {
      display: none;
    }

    .category-hero h1 {
      font-size: 40px;
    }
  }

  @media (max-width: 760px) {
    .category-hero h1 {
      font-size: 32px;
    }

    .category-hero__text p {
      font-size: 15px;
    }
  }
</style>
