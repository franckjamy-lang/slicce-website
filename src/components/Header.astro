---
import Icon from './Icon.astro';
import SearchModal from './SearchModal.astro';
import ProductNavItem from './ProductNavItem.astro';
import { mainNav, productsMenu, useCasesMenu } from '../data/navigation';

const currentPath = Astro.url.pathname;
// Page d'accueil : header transparent par-dessus le hero noir, avec un gros
// logo qui rétrécit au scroll (cf. style + script plus bas). Sur les autres
// pages, le header garde son apparence normale (fond blanc, logo sombre).
const isHome = currentPath === '/';

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(href + '/');
}
---

<header class:list={['site-header', { 'site-header--hero': isHome }]}>
  <div class="site-header__bar">
    <a href="/" class="site-header__logo" aria-label="Slicce — accueil">
      {isHome ? (
        <>
          <img
            src="/images/brand/slicce-logo-white.svg"
            alt="Slicce"
            height="24"
            class="site-header__logo-img site-header__logo-img--white"
          />
          <img
            src="/images/brand/slicce-logo.svg"
            alt="Slicce"
            height="24"
            class="site-header__logo-img site-header__logo-img--dark"
          />
        </>
      ) : (
        <img src="/images/brand/slicce-logo.svg" alt="Slicce" height="24" />
      )}
    </a>

    <div class="site-header__right">
      <nav id="primary-nav" class="site-nav" aria-label="Navigation principale">
        <ul class="site-nav__list">
          {mainNav.map((item) => {
            if (item.label === 'Products') {
              return (
                <li class="site-nav__item site-nav__item--has-menu">
                  <a href={item.href} class:list={['site-nav__link', { 'is-active': isActive(item.href) }]}>
                    {item.label}
                    <Icon name="chevron-down" size={14} class="site-nav__chevron" />
                  </a>
                  <ul class="site-nav__dropdown">
                    {productsMenu.map((group) => <ProductNavItem item={group} currentPath={currentPath} />)}
                  </ul>
                </li>
              );
            }

            if (item.label === 'Use cases') {
              return (
                <li class="site-nav__item site-nav__item--has-menu">
                  <a href={item.href} class:list={['site-nav__link', { 'is-active': isActive(item.href) }]}>
                    {item.label}
                    <Icon name="chevron-down" size={14} class="site-nav__chevron" />
                  </a>
                  <ul class="site-nav__dropdown">
                    {useCasesMenu.map((useCase) => (
                      <li class="site-nav__dropdown-item">
                        <a href={useCase.href} class:list={{ 'is-active': isActive(useCase.href) }}>{useCase.label}</a>
                      </li>
                    ))}
                  </ul>
                </li>
              );
            }

            return (
              <li class="site-nav__item">
                <a href={item.href} class:list={['site-nav__link', { 'is-active': isActive(item.href) }]}>
                  {item.label}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>

      <button id="search-toggle" class="site-header__search" aria-label="Rechercher sur le site">
        <Icon name="search" size={20} />
      </button>

      <button
        id="nav-toggle"
        class="site-header__toggle"
        aria-expanded="false"
        aria-controls="primary-nav"
      >
        <span class="visually-hidden">Menu</span>
        <span class="site-header__toggle-bar" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<SearchModal />

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('primary-nav');

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    nav?.classList.toggle('is-open');
  });

  // Accordéon du menu Products : chaque catégorie/sous-catégorie a son
  // propre chevron qui déplie/replie ses enfants en place, identique sur
  // desktop et mobile (pas besoin de distinguer les deux ici).
  document.querySelectorAll<HTMLElement>('.site-nav__toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
    });
  });

  // Intro du header sur la home (grand écran uniquement) : au chargement, le
  // header est transparent, superposé au hero noir, avec un gros logo. Au
  // premier scroll, le logo rétrécit à sa taille normale (classe
  // "is-shrunk"), puis une fois le bas du hero dépassé (section blanche
  // suivante atteinte), le header devient blanc et le logo/la nav passent en
  // sombre (classe "is-flipped"). Effet à sens unique et joué une seule fois :
  // une fois déclenché, il n'est jamais rejoué ni inversé si on remonte
  // ensuite en haut de page (seul un rechargement de page le réinitialise).
  const heroHeader = document.querySelector<HTMLElement>('.site-header--hero');
  const heroSection = document.getElementById('hero');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isDesktop = window.matchMedia('(min-width: 961px)').matches;

  if (heroHeader && heroSection && isDesktop && !prefersReducedMotion) {
    let shrunk = false;
    let flipped = false;
    let ticking = false;

    const update = () => {
      ticking = false;
      if (!shrunk && window.scrollY > 4) {
        shrunk = true;
        heroHeader.classList.add('is-shrunk');
      }
      if (!flipped && window.scrollY >= heroSection.offsetHeight - 1) {
        flipped = true;
        heroHeader.classList.add('is-flipped');
      }
      if (shrunk && flipped) {
        window.removeEventListener('scroll', onHeroScroll);
      }
    };

    const onHeroScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    window.addEventListener('scroll', onHeroScroll, { passive: true });
    update(); // cas d'un chargement déjà scrollé (retour navigateur, ancre…)
  } else if (heroHeader) {
    // Mobile / tablette ou "reduced motion" : pas d'effet hero, le header se
    // comporte comme sur les autres pages dès le chargement.
    heroHeader.classList.add('is-shrunk', 'is-flipped');
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-white);
    border-bottom: 1px solid var(--border-subtle);
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-4);
    padding-inline: var(--space-8);
  }

  .site-header__logo {
    display: inline-flex;
    align-items: center;
  }

  /* Par défaut (toutes pages, tous écrans) : seul le logo sombre existe/est
     affiché. Sur la home en grand écran, les deux images sont rendues et la
     règle ci-dessous est neutralisée par le média-query "hero" plus bas. */
  .site-header__logo-img--white {
    display: none;
  }

  .site-header__right {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .site-header__search {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 0;
    color: var(--color-ink);
    cursor: pointer;
    padding: var(--space-1);
  }

  .site-header__search:hover {
    opacity: 0.7;
  }

  .site-header__toggle {
    display: none;
    background: transparent;
    border: 0;
    color: var(--color-ink);
    cursor: pointer;
    padding: var(--space-2);
  }

  .site-header__toggle-bar,
  .site-header__toggle-bar::before,
  .site-header__toggle-bar::after {
    display: block;
    width: 22px;
    height: 2px;
    background: currentColor;
    position: relative;
  }

  .site-header__toggle-bar::before,
  .site-header__toggle-bar::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .site-header__toggle-bar::before {
    top: -6px;
  }

  .site-header__toggle-bar::after {
    top: 6px;
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav__item {
    position: relative;
  }

  .site-nav__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-ink);
    font-size: 18px;
    font-weight: 500;
    padding: var(--space-2) 0;
  }

  .site-nav__link.is-active {
    font-weight: 700;
  }

  .site-nav__link:hover {
    text-decoration: none;
    opacity: 0.7;
  }

  .site-nav__chevron {
    color: var(--color-ink);
  }

  /* --- Niveau 1 : liste verticale simple (Products, Use cases) --- */
  .site-nav__dropdown {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 280px;
    background: var(--color-white);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-md);
    padding: var(--space-2);
    list-style: none;
    margin: 0;
    z-index: 10;
  }

  .site-nav__item--has-menu:hover > .site-nav__dropdown,
  .site-nav__item--has-menu:focus-within > .site-nav__dropdown {
    display: block;
  }

  /* "Use cases" est une simple liste plate (pas d'imbrication) */
  .site-nav__dropdown-item > a {
    display: block;
    padding: var(--space-3);
    color: var(--color-ink);
    font-size: 14px;
    white-space: nowrap;
    border-radius: var(--radius-sm);
  }

  .site-nav__dropdown-item > a:hover {
    background: var(--color-off-white);
    text-decoration: none;
  }

  .site-nav__dropdown-item > a.is-active {
    font-weight: 700;
    color: var(--color-ink);
  }

  @media (max-width: 960px) {
    .site-header__bar {
      position: relative;
    }

    .site-header__toggle {
      display: inline-flex;
    }

    .site-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--color-white);
      border-top: 1px solid var(--border-subtle);
      max-height: calc(100vh - 100%);
      overflow-y: auto;
    }

    .site-nav.is-open {
      display: block;
    }

    .site-nav__list {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      padding-block: var(--space-4);
    }

    .site-nav__item {
      width: 100%;
    }

    .site-nav__link {
      width: 100%;
      padding: var(--space-3) 0;
    }

    /* Sur mobile, le niveau juste sous "Products"/"Use cases" est toujours
       déplié (pas de survol possible) ; les niveaux plus profonds gardent
       leur propre chevron cliquable (ProductNavItem), identique au desktop. */
    .site-nav__dropdown {
      display: block;
      position: static;
      min-width: 0;
      border: 0;
      box-shadow: none;
      padding: 0 var(--space-4) var(--space-2) var(--space-4);
    }

    .site-nav__dropdown-item > a {
      padding: var(--space-2) 0;
    }
  }

  /* --- Effet "hero" (home, grand écran uniquement) ---
     Au chargement : header transparent superposé au hero noir (le skyline
     monte jusqu'en haut de la fenêtre), logo agrandi, nav en blanc.
     Au 1er scroll : le logo revient à sa taille normale ("is-shrunk").
     Une fois le bas du hero dépassé : header blanc, logo et nav en sombre
     ("is-flipped"). Ces deux étapes ne se rejouent/inversent jamais après
     coup (cf. script) : elles n'ont lieu qu'au chargement de la page. */
  @media (min-width: 961px) {
    .site-header--hero {
      --hero-logo-scale: 4.5;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      background: transparent;
      border-bottom-color: transparent;
      transition: background-color 0.4s ease, border-color 0.4s ease;
    }

    .site-header--hero .site-header__logo {
      transform-origin: top left;
      transform: scale(var(--hero-logo-scale));
      transition: transform 0.6s ease;
    }

    .site-header--hero .site-header__logo-img--white {
      display: inline-block;
    }

    .site-header--hero .site-header__logo-img--dark {
      display: none;
    }

    .site-header--hero .site-nav__link,
    .site-header--hero .site-nav__chevron,
    .site-header--hero .site-header__search,
    .site-header--hero .site-header__toggle {
      color: var(--color-white);
      transition: color 0.4s ease;
    }

    .site-header--hero.is-shrunk .site-header__logo {
      transform: scale(1);
    }

    .site-header--hero.is-flipped {
      background: var(--color-white);
      border-bottom-color: var(--border-subtle);
    }

    .site-header--hero.is-flipped .site-header__logo-img--white {
      display: none;
    }

    .site-header--hero.is-flipped .site-header__logo-img--dark {
      display: inline-block;
    }

    .site-header--hero.is-flipped .site-nav__link,
    .site-header--hero.is-flipped .site-nav__chevron,
    .site-header--hero.is-flipped .site-header__search,
    .site-header--hero.is-flipped .site-header__toggle {
      color: var(--color-ink);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header--hero .site-header__logo {
      transition: none;
    }
  }
</style>
