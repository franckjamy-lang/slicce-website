---
// Bandeau noir utilisé en tête des pages "utilitaires" (Catalog, Articles,
// Blog) : même visuel skyline que le hero de la home, mais recadré/poussé
// vers la droite (quitte à être coupé) sur une bande courte, avec le titre
// et la description de la page calés à gauche.
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<section class="page-banner">
  <div class="page-banner__media">
    <img src="/images/hero/skyline.jpg" alt="" width="1772" height="1000" />
    <div class="page-banner__fade"></div>
  </div>
  <div class="container page-banner__content">
    <h1 data-reveal>{title}</h1>
    <p data-reveal>{description}</p>
  </div>
</section>

<style>
  .page-banner {
    position: relative;
    height: 280px;
    display: flex;
    align-items: center;
    background: var(--color-black-soft);
    color: var(--text-inverse);
    overflow: hidden;
  }

  .page-banner__media {
    position: absolute;
    inset: 0;
  }

  .page-banner__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 82% 60%;
    display: block;
  }

  .page-banner__fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--color-black-soft) 0%, var(--color-black-soft) 30%, transparent 62%);
  }

  .page-banner__content {
    position: relative;
    z-index: 2;
  }

  .page-banner__content h1 {
    color: var(--text-inverse);
    font-size: 40px;
    margin-bottom: var(--space-2);
  }

  .page-banner__content p {
    font-family: var(--font-heading);
    font-size: 16px;
    line-height: 1.4;
    color: var(--text-inverse);
    max-width: 520px;
    margin: 0;
  }

  @media (max-width: 780px) {
    .page-banner {
      height: 200px;
    }

    .page-banner__content h1 {
      font-size: 28px;
    }

    .page-banner__content p {
      font-size: 14px;
    }
  }
</style>
