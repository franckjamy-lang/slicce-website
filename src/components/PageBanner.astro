---
// Bandeau noir utilisé en tête des pages "utilitaires" (Catalog, Articles,
// Blog) : même visuel skyline que le hero de la home, mais recadré/poussé
// vers la droite (quitte à être coupé) sur une bande courte, avec le titre
// et la description de la page calés à gauche.
interface Props {
  // Peut contenir du HTML simple (ex: "Line one<br />Line two") pour forcer
  // un retour à la ligne — voir products/index.astro.
  title: string;
  description?: string;
  accentTitle?: boolean;
  icon?: string;
  // Petit label vert au-dessus du titre (ex: "Use Case" sur les 6 pages
  // use-cases/*) — absent sur les autres pages utilisant ce bandeau.
  kicker?: string;
  // Taille du titre (px) pour une page donnée uniquement (ex: Technology) ;
  // par défaut, garde la taille commune définie ci-dessous (48px).
  titleSize?: number;
}
const { title, description, accentTitle = false, icon, kicker, titleSize } = Astro.props;
---

<section class="page-banner">
  <div class="page-banner__media">
    <img src="/images/hero/skyline.jpg" alt="" width="1772" height="1000" />
    <div class="page-banner__fade"></div>
  </div>
  <div class="container page-banner__content">
    {kicker && <p class="page-banner__kicker" data-reveal>{kicker}</p>}
    <h1
      data-reveal
      class:list={[{ 'is-accent': accentTitle }]}
      style={titleSize ? `font-size:${titleSize}px` : undefined}
      set:html={title}
    />
    {description && <p data-reveal>{description}</p>}
  </div>
  {
    icon && (
      <div class="page-banner__icon" data-reveal="right">
        <img src={icon} alt="" width="200" height="200" loading="lazy" />
      </div>
    )
  }
</section>

<style>
  .page-banner {
    position: relative;
    height: 280px;
    display: flex;
    align-items: center;
    background: var(--color-black-soft);
    color: var(--text-inverse);
    overflow: hidden;
  }

  .page-banner__media {
    position: absolute;
    inset: 0;
  }

  .page-banner__media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: right center;
    display: block;
  }

  .page-banner__fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--color-black-soft) 0%, var(--color-black-soft) 30%, transparent 62%);
  }

  .page-banner__content {
    position: relative;
    z-index: 2;
  }

  .page-banner__content h1 {
    color: var(--text-inverse);
    font-size: 48px;
    margin-bottom: var(--space-3);
  }

  .page-banner__content h1.is-accent {
    color: var(--color-green);
  }

  .page-banner__kicker {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 22px;
    color: var(--color-green);
    margin-bottom: var(--space-1);
  }

  .page-banner__content p {
    font-family: var(--font-heading);
    font-size: 18px;
    line-height: 1.45;
    color: var(--text-inverse);
    max-width: 460px;
    text-wrap: balance;
    margin: 0;
  }

  .page-banner__icon {
    position: absolute;
    right: 60px;
    bottom: 0;
    z-index: 2;
  }

  .page-banner__icon img {
    max-height: 200px;
    width: auto;
  }

  @media (max-width: 1100px) {
    .page-banner__icon {
      display: none;
    }
  }

  @media (max-width: 780px) {
    .page-banner {
      height: 200px;
    }

    /* En dessous de cette largeur, l'image garde son ratio d'origine mais le
       bandeau devient bien plus bas que large : elle finit par occuper
       presque toute la largeur (au lieu d'un tiers droit comme en desktop)
       et chevauche le texte. On la masque, le fond noir uni suffit. */
    .page-banner__media {
      display: none;
    }

    .page-banner__content h1 {
      font-size: 32px;
    }

    .page-banner__content p {
      font-size: 15px;
    }
  }
</style>
