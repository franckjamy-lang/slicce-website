---
// Widget articles — anciennement encapsulé dans un iframe hébergé sur
// files.slicce.co, désormais intégré directement dans la page (voir
// src/pages/articles.astro). Données lues depuis un JSON hébergé sur GitHub
// (console d'admin unifiée de Franck) ; le contenu de chaque article est du
// HTML déjà prêt à l'affichage (plus de rendu Markdown côté client). Le
// "pont" iframe↔page parente (postMessage) et le tag GTM ont été retirés,
// devenus inutiles/redondants hors iframe (GTM sera ajouté une seule fois,
// site-wide, à l'étape 7 du projet).
---

<div id="articles-widget-scope">
  <div class="widget">
    <div id="hero-container"></div>
    <div class="filter-bar" id="filter-bar"></div>
    <div class="article-grid" id="article-grid">
      <div class="loader">Loading articles…</div>
    </div>
  </div>

  <!-- Modal article -->
  <div class="modal-overlay" id="modal-overlay">
    <div class="modal" id="modal">
      <button class="modal-close" id="modal-close-btn" title="Close">✕</button>
      <img class="modal-cover" id="modal-cover" src="" alt="" />
      <div class="modal-body">
        <div class="modal-meta">
          <div class="modal-cats" id="modal-cats"></div>
          <span class="modal-dot" id="modal-dot">·</span>
          <span class="modal-date" id="modal-date"></span>
        </div>
        <h1 class="modal-title" id="modal-title"></h1>
        <div class="prose" id="modal-prose"></div>
        <a class="modal-ext-link" id="modal-ext-link" href="#" target="_blank">↗ View full article</a>
      </div>
    </div>
  </div>
</div>

<script>
  /* ============================================================
     ▼  CONFIGURATION  ▼
     JSON hébergé sur GitHub (voir "Settings" dans la console d'admin) :
     https://raw.githubusercontent.com/{ghOwner}/{ghRepo}/{ghBranch}/{ghPath}
     Le fichier doit contenir { "articles": [ {titre, date, extrait, image,
     lien, categorie, featured, contenu (HTML)}, ... ] }
     ============================================================ */
  const CONFIG = {
    ghOwner: 'franckjamy-lang',
    ghRepo: 'slicce-data',
    ghPath: 'articles-data.json',
    ghBranch: 'main',
    maxItems: 12,
    heroLayout: 'square', // 'square' | 'portrait' | 'landscape'
  };

  /* ============================================================
     DONNÉES DE DÉMO (fallback si le Sheet est inaccessible)
     ============================================================ */
  const DEMO = [
    {
      titre: "CAPIF : le cœur de l'exposition d'API en 5G",
      date: '12 avril 2025',
      extrait:
        "Découvrez comment la fonction CAPIF standardise l'accès aux APIs dans les architectures 5G et simplifie l'intégration pour les développeurs.",
      image: 'https://images.unsplash.com/photo-1558494949-ef010cbdcc31?w=800&q=75',
      lien: 'https://www.slicce.co/products/capif-core-function',
      categorie: '5G',
      featured: 'oui',
      contenu: `<h2>Introduction</h2>
<p>La <strong>Common API Framework (CAPIF)</strong> est définie par le 3GPP comme la fonction centrale d'exposition d'APIs dans les réseaux 5G. Elle standardise la manière dont les applications externes accèdent aux capabilities réseau.</p>
<h2>Architecture CAPIF</h2>
<p>Le framework repose sur trois entités principales :</p>
<ul>
<li><strong>CAPIF Core Function</strong> — le cœur du système, gère l'enregistrement et la découverte d'APIs</li>
<li><strong>API Exposing Function (AEF)</strong> — expose les APIs réseau aux applications tierces</li>
<li><strong>API Invoking Function (AIF)</strong> — représente l'application qui consomme les APIs</li>
</ul>
<h2>Pourquoi adopter CAPIF ?</h2>
<blockquote>
<p>CAPIF simplifie radicalement l'intégration pour les développeurs tiers en offrant un point d'entrée unique, standardisé et sécurisé.</p>
</blockquote>
<p>Les bénéfices concrets pour les opérateurs :</p>
<ol>
<li><strong>Sécurité renforcée</strong> — authentification et autorisation centralisées</li>
<li><strong>Monétisation simplifiée</strong> — contrôle fin des accès et de la facturation</li>
<li><strong>Interopérabilité</strong> — compatibilité entre équipements de différents fournisseurs</li>
</ol>
<h2>Conclusion</h2>
<p>CAPIF est devenu un composant incontournable pour tout opérateur souhaitant exposer ses capabilities réseau de manière sécurisée et scalable.</p>`,
    },
    {
      titre: 'Comment les opérateurs monétisent leurs APIs réseau',
      date: '3 avril 2025',
      extrait:
        "L'exposition d'APIs réseau représente une nouvelle source de revenus. Modèles commerciaux et meilleures pratiques.",
      image: 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=600&q=70',
      lien: 'https://www.slicce.co/blog',
      categorie: 'API',
      featured: 'non',
      contenu: `<h2>Un marché en pleine croissance</h2>
<p>La monétisation des APIs réseau est devenue un enjeu stratégique pour les opérateurs télécoms. Selon les analystes, ce marché représentera <strong>plus de 15 milliards USD d'ici 2027</strong>.</p>
<h2>Les principaux modèles de revenus</h2>
<ul>
<li><strong>Pay-per-use</strong> — facturation à l'appel d'API</li>
<li><strong>Abonnement</strong> — accès forfaitaire mensuel ou annuel</li>
<li><strong>Revenue sharing</strong> — partage de revenus avec les développeurs</li>
</ul>
<h2>Meilleures pratiques</h2>
<blockquote>
<p>Commencez par exposer des APIs à forte valeur ajoutée : localisation, SMS, vérification d'identité.</p>
</blockquote>
<p>Les opérateurs les plus performants combinent une <strong>plateforme technique robuste</strong> (CAPIF, NEF) avec un <strong>portail développeurs</strong> soigné.</p>`,
    },
    {
      titre: 'Private Networks : déployer la 5G en entreprise',
      date: '25 mars 2025',
      extrait:
        'Les réseaux privés 5G transforment les opérations industrielles. Architectures, cas d\'usage et considérations de déploiement.',
      image: 'https://images.unsplash.com/photo-1504711434969-e33886168f5c?w=600&q=70',
      lien: 'https://www.slicce.co/use-cases/private-networks',
      categorie: 'Cloud',
      featured: 'non',
      contenu: `<h2>Qu'est-ce qu'un réseau privé 5G ?</h2>
<p>Un réseau privé 5G est une infrastructure cellulaire dédiée à une organisation, déployée dans ses locaux ou en cloud. Il offre les performances de la 5G avec un contrôle total sur la sécurité et les données.</p>
<h2>Cas d'usage industriels</h2>
<ul>
<li><strong>Industrie 4.0</strong> — robotique mobile, AGV, contrôle en temps réel</li>
<li><strong>Logistique</strong> — traçabilité, drones de manutention</li>
<li><strong>Santé</strong> — imagerie médicale, monitoring à distance</li>
<li><strong>Énergie</strong> — surveillance d'infrastructures critiques</li>
</ul>
<h2>Architecture de déploiement</h2>
<blockquote>
<p>Le mode <em>standalone</em> avec core réseau on-premise offre la latence la plus faible, idéale pour les applications temps réel.</p>
</blockquote>
<p>Trois modèles existent : <strong>on-premise</strong>, <strong>edge cloud</strong> et <strong>hybride</strong>. Le choix dépend des contraintes de latence, sécurité et budget.</p>`,
    },
    {
      titre: 'Interworking SMS entre réseaux legacy et 5G',
      date: '18 mars 2025',
      extrait:
        'La coexistence entre réseaux CS legacy et IMS/5G nécessite des fonctions d\'interworking robustes.',
      image: 'https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?w=600&q=70',
      lien: 'https://www.slicce.co/products/interworking-functions/short-message-iwf',
      categorie: 'Interworking',
      featured: 'non',
      contenu: `<h2>Le défi de la transition</h2>
<p>Malgré le déploiement massif de la 5G, les réseaux <strong>circuit-switched (CS) legacy</strong> continuent d'opérer en parallèle. Cette coexistence crée des défis techniques, notamment pour la continuité du service SMS.</p>
<h2>Rôle de la SMS-IWF</h2>
<p>La <strong>Short Message Interworking Function</strong> assure la translation de protocoles entre :</p>
<ul>
<li>SS7/MAP (réseaux 2G/3G)</li>
<li>IMS/SIP (réseaux 4G/5G)</li>
<li>Diameter (cœur EPC)</li>
</ul>
<h2>Points de vigilance</h2>
<blockquote>
<p>La gestion des numéros de routage (MSISDN vs IMSI) est critique pour éviter les pertes de messages lors des handovers inter-réseaux.</p>
</blockquote>
<p>Les opérateurs doivent également gérer la <strong>charge de signalisation</strong> lors des pics de trafic SMS (réveillon, événements).</p>`,
    },
    {
      titre: 'CAMARA : standardiser les APIs telco au niveau mondial',
      date: '10 mars 2025',
      extrait:
        'Le projet CAMARA de la GSMA harmonise les APIs réseau entre opérateurs, ouvrant la voie à un marché mondial.',
      image: 'https://images.unsplash.com/photo-1607799279861-4dd421887fb3?w=600&q=70',
      lien: 'https://www.slicce.co/blog',
      categorie: '5G',
      featured: 'non',
      contenu: `<h2>Le projet CAMARA</h2>
<p><strong>CAMARA</strong> est une initiative open source co-pilotée par la GSMA et la Linux Foundation. Son objectif : définir des APIs réseau standardisées, utilisables de la même manière chez n'importe quel opérateur mondial.</p>
<h2>APIs disponibles</h2>
<ul>
<li><em>Number Verification</em> — vérifie le numéro de téléphone d'un utilisateur</li>
<li><em>Device Location</em> — localisation du device en temps réel</li>
<li><em>Quality on Demand (QoD)</em> — garantie de bande passante pour une session</li>
<li><em>SIM Swap</em> — détection des changements de SIM récents</li>
</ul>
<h2>Impact pour l'écosystème</h2>
<blockquote>
<p>Un développeur peut désormais écrire son application une seule fois et la déployer chez tous les opérateurs membres CAMARA.</p>
</blockquote>
<p>C'est une révolution pour l'industrie telco, comparable à ce qu'AWS a représenté pour le cloud computing.</p>`,
    },
    {
      titre: 'NEF et SCEF : passerelles vers les APIs 5G Core',
      date: '2 mars 2025',
      extrait: 'La Network Exposure Function est la clé de voûte de l\'exposition sécurisée des capabilities 5G.',
      image: 'https://images.unsplash.com/photo-1509718443690-d8e2fb3474b7?w=600&q=70',
      lien: 'https://www.slicce.co/blog',
      categorie: 'API',
      featured: 'non',
      contenu: `<h2>NEF vs SCEF</h2>
<p>La <strong>Network Exposure Function (NEF)</strong> est le composant 5G Core qui succède à la <strong>SCEF</strong> (Service Capability Exposure Function) de la 4G. Elle centralise l'exposition sécurisée des capabilities réseau vers les applications tierces.</p>
<h2>Fonctions principales</h2>
<ul>
<li><strong>Traduction de protocoles</strong> entre SBI (5G) et APIs REST externes</li>
<li><strong>Gestion des politiques</strong> d'accès et de sécurité</li>
<li><strong>Analytics</strong> et monitoring des appels d'API</li>
<li><strong>Facturation</strong> et rate limiting</li>
</ul>
<h2>Relation avec CAPIF</h2>
<blockquote>
<p>NEF est l'implémentation concrète du rôle AEF dans l'architecture CAPIF, assurant l'exposition effective des services réseau.</p>
</blockquote>
<p>La combinaison NEF + CAPIF forme le socle technique de toute plateforme d'APIs telco moderne.</p>`,
    },
    {
      titre: 'Architecture Cloud-Native pour les fonctions réseau',
      date: '22 février 2025',
      extrait:
        'La virtualisation (VNF) et la conteneurisation (CNF) des fonctions réseau redéfinissent les infrastructures télécoms.',
      image: 'https://images.unsplash.com/photo-1544197150-b99a580bb7a8?w=600&q=70',
      lien: 'https://www.slicce.co/technology',
      categorie: 'Cloud',
      featured: 'non',
      contenu: `<h2>Du matériel au logiciel</h2>
<p>La transformation Cloud-Native des réseaux télécoms représente un changement de paradigme : les fonctions réseau passent de <strong>hardware dédié</strong> à des <strong>microservices containerisés</strong> déployables sur infrastructure standard.</p>
<h2>VNF vs CNF</h2>
<table>
<thead>
<tr><th></th><th>VNF</th><th>CNF</th></tr>
</thead>
<tbody>
<tr><td>Déploiement</td><td>VM</td><td>Container (K8s)</td></tr>
<tr><td>Scalabilité</td><td>Verticale</td><td>Horizontale</td></tr>
<tr><td>Temps de démarrage</td><td>Minutes</td><td>Secondes</td></tr>
</tbody>
</table>
<h2>Kubernetes comme socle</h2>
<blockquote>
<p>La majorité des opérateurs Tier-1 ont adopté Kubernetes comme orchestrateur standard pour leurs CNF 5G Core.</p>
</blockquote>
<p>Les bénéfices : <strong>réduction des CAPEX</strong>, déploiement accéléré de nouvelles features, et résilience améliorée grâce à l'auto-healing.</p>`,
    },
  ];

  /* ============================================================
     MOTEUR
     ============================================================ */
  let allCards: any[] = [];
  let activeFilter = 'All';

  function esc(s: string) {
    return (s || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function formatDate(str: string) {
    if (!str) return '';
    const months: Record<string, string> = {
      janvier: 'January', février: 'February', mars: 'March', avril: 'April',
      mai: 'May', juin: 'June', juillet: 'July', août: 'August',
      septembre: 'September', octobre: 'October', novembre: 'November', décembre: 'December',
      january: 'January', february: 'February', march: 'March', april: 'April',
      may: 'May', june: 'June', july: 'July', august: 'August',
      september: 'September', october: 'October', november: 'November', december: 'December',
    };
    const m = str.trim().match(/^(\d{1,2})\s+([A-Za-zéûôîèùà]+)\s+(\d{4})$/);
    if (m) {
      const month = months[m[2].toLowerCase()];
      return month ? `${month} ${parseInt(m[1])}, ${m[3]}` : str;
    }
    const mIso = str.trim().match(/^(\d{4})-(\d{2})-(\d{2})$/);
    if (mIso) {
      const d = new Date(str + 'T00:00:00');
      return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
    }
    return str;
  }

  async function loadData() {
    if (CONFIG.ghOwner && CONFIG.ghRepo) {
      try {
        const url =
          'https://raw.githubusercontent.com/' +
          CONFIG.ghOwner + '/' + CONFIG.ghRepo + '/' + CONFIG.ghBranch + '/' + CONFIG.ghPath +
          '?t=' + Date.now();
        const r = await fetch(url, { cache: 'no-store' });
        if (!r.ok) throw new Error('HTTP ' + r.status);
        const db = await r.json();
        const rows = (db.articles || []).filter((a: any) => a.titre);
        if (rows.length === 0) throw new Error('No articles found');
        return rows.slice(0, CONFIG.maxItems);
      } catch (e: any) {
        console.warn('[Widget] Erreur GitHub :', e.message, '→ demo data.');
      }
    }
    return DEMO;
  }

  (window as any)._art = [];

  function renderBadges(catStr: string, cls: string) {
    if (!catStr) return '';
    return catStr
      .split(',')
      .map((c) => c.trim())
      .filter(Boolean)
      .map((c) => `<span class="${cls}">${esc(c)}</span>`)
      .join('');
  }

  function renderHero(a: any, idx: number) {
    if (!a) return;
    (window as any)._art[idx] = a;
    const hasContent = (a.contenu && a.contenu.trim()) || (a.extrait && a.extrait.trim());
    const btn = hasContent
      ? `<button class="btn btn-hero" data-open-modal="${idx}">Read article →</button>`
      : a.lien
        ? `<a class="btn btn-hero" href="${esc(a.lien)}" target="_blank">Read article →</a>`
        : '';
    const layout = a.layout || CONFIG.heroLayout || 'square';
    const badges = a.categorie ? `<div class="badge-wrap">${renderBadges(a.categorie, 'badge')}</div>` : '';
    const meta = `
      ${badges}
      ${a.date ? `<time class="hero-date">${formatDate(a.date)}</time>` : ''}
      <h2 class="hero-title">${esc(a.titre)}</h2>
      ${a.extrait ? `<p class="hero-exc">${esc(a.extrait)}</p>` : ''}`;
    const bodyInner = `${meta}${btn}`;
    const heroEl = document.getElementById('hero-container');
    if (heroEl) {
      heroEl.innerHTML = `
        <div class="hero layout-${layout}">
          <div class="hero-image">
            <img src="${esc(a.image)}" alt="${esc(a.titre)}" />
          </div>
          <div class="hero-body">${bodyInner}</div>
        </div>`;
      const img = heroEl.querySelector('img');
      img?.addEventListener('error', () => {
        img.src = 'https://images.unsplash.com/photo-1558494949-ef010cbdcc31?w=800&q=75';
      });
    }
  }

  function renderFilters(articles: any[]) {
    const allArticles = [(window as any)._art[0], ...articles].filter(Boolean);
    const cats = [
      'All',
      ...new Set(allArticles.flatMap((a) => (a.categorie || '').split(',').map((c: string) => c.trim()).filter(Boolean))),
    ];
    const bar = document.getElementById('filter-bar');
    if (bar) {
      bar.innerHTML =
        '<span class="filter-label">Filter:</span>' +
        cats
          .map((c) => `<button class="filter-btn${c === activeFilter ? ' active' : ''}" data-filter="${esc(c)}">${esc(c)}</button>`)
          .join('');
    }
  }

  function renderGrid(articles: any[], startIdx: number) {
    const g = document.getElementById('article-grid');
    if (!g) return;
    if (!articles.length) {
      g.innerHTML = '<div class="empty">No articles in this category.</div>';
      return;
    }
    try {
      g.innerHTML = articles
        .map((a, i) => {
          const idx = startIdx + i;
          (window as any)._art[idx] = a;
          const hasContent = (a.contenu && a.contenu.trim()) || (a.extrait && a.extrait.trim());
          const cta = hasContent
            ? `<button class="btn btn-card" data-open-modal="${idx}">Read article →</button>`
            : a.lien
              ? `<a class="btn btn-card" href="${esc(a.lien)}" target="_blank">Read article →</a>`
              : '';
          return `
            <article class="card">
              <img class="card-img" src="${esc(a.image || '')}" alt="${esc(a.titre || '')}" data-fallback-hide />
              <div class="card-body">
                ${a.categorie ? `<div class="badge-wrap">${renderBadges(a.categorie, 'card-cat')}</div>` : ''}
                ${a.date ? `<time class="card-date">${formatDate(a.date)}</time>` : ''}
                <h3 class="card-title">${esc(a.titre || '')}</h3>
                ${a.extrait ? `<p class="card-exc">${esc(a.extrait)}</p>` : ''}
                ${cta ? `<div class="card-footer" style="margin-top:auto">${cta}</div>` : ''}
              </div>
            </article>`;
        })
        .join('');
      g.querySelectorAll<HTMLImageElement>('img[data-fallback-hide]').forEach((img) => {
        img.addEventListener('error', () => { img.style.display = 'none'; });
      });
    } catch (err) {
      console.error('[Widget] renderGrid error:', err);
      g.innerHTML = '<div class="empty">Error rendering articles.</div>';
    }
  }

  function filterBy(btn: HTMLElement, cat: string) {
    activeFilter = cat;
    document.querySelectorAll('.filter-btn').forEach((b) => b.classList.remove('active'));
    btn.classList.add('active');
    const filteredList =
      cat === 'All' ? allCards : allCards.filter((a) => (a.categorie || '').split(',').map((c: string) => c.trim()).includes(cat));
    renderGrid(filteredList, 1);
    (window as any).dataLayer = (window as any).dataLayer || [];
    pushEvent({ event: 'filter_click', filter_category: cat });
  }

  function openModal(idx: number) {
    const a = (window as any)._art[idx];
    if (!a) return;
    (document.getElementById('modal-cover') as HTMLImageElement).src = a.image || '';
    (document.getElementById('modal-cover') as HTMLImageElement).alt = a.titre || '';
    document.getElementById('modal-cats')!.innerHTML = renderBadges(a.categorie || '', 'modal-cat-badge');
    (document.getElementById('modal-dot') as HTMLElement).style.display = a.categorie && a.date ? '' : 'none';
    document.getElementById('modal-date')!.textContent = formatDate(a.date);
    document.getElementById('modal-title')!.textContent = a.titre || '';

    const prose = document.getElementById('modal-prose')!;
    if (a.contenu && a.contenu.trim()) {
      // Le contenu vient déjà en HTML prêt à l'affichage (rendu côté admin).
      prose.innerHTML = a.contenu;
    } else {
      prose.innerHTML = a.extrait ? `<p>${esc(a.extrait)}</p>` : '';
    }

    const extLink = document.getElementById('modal-ext-link') as HTMLAnchorElement;
    if (a.lien) {
      extLink.href = a.lien;
      extLink.style.display = 'inline-flex';
    } else {
      extLink.style.display = 'none';
    }

    document.getElementById('modal-overlay')!.classList.add('open');
    document.body.style.overflow = 'hidden';
    pushEvent({ event: 'article_view', article_title: a.titre || '', article_category: a.categorie || '', article_date: a.date || '' });
  }

  function closeModal() {
    document.getElementById('modal-overlay')!.classList.remove('open');
    document.body.style.overflow = '';
  }

  document.getElementById('modal-overlay')?.addEventListener('click', (e) => {
    if (e.target === document.getElementById('modal-overlay')) closeModal();
  });
  document.getElementById('modal-close-btn')?.addEventListener('click', () => closeModal());
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

  // Délégation d'événements (les boutons sont recréés à chaque rendu)
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const filterBtn = target.closest<HTMLElement>('[data-filter]');
    if (filterBtn) { filterBy(filterBtn, filterBtn.dataset.filter!); return; }
    const modalBtn = target.closest<HTMLElement>('[data-open-modal]');
    if (modalBtn) { openModal(Number(modalBtn.dataset.openModal)); }
  });

  function pushEvent(payload: Record<string, unknown>) {
    (window as any).dataLayer = (window as any).dataLayer || [];
    (window as any).dataLayer.push(payload);
  }

  (async () => {
    try {
      const data = await loadData();
      const heroIdx = data.findIndex((a: any) => (a.featured || '').toLowerCase() === 'oui');
      const hIdx = heroIdx >= 0 ? heroIdx : 0;
      const hero = data[hIdx];
      allCards = data.filter((_: any, i: number) => i !== hIdx);
      renderHero(hero, 0);
      renderFilters(allCards);
      renderGrid(allCards, 1);
    } catch (err) {
      console.error('[Widget] Init error:', err);
      const grid = document.getElementById('article-grid');
      if (grid) grid.innerHTML = '<div class="empty">Error loading articles. Check console for details.</div>';
    }
  })();
</script>

<style is:global>
