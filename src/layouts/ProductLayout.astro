---
import BaseLayout from './BaseLayout.astro';
import SectionDots from '../components/SectionDots.astro';
import GetStartedSection from '../components/home/GetStartedSection.astro';
import Icon from '../components/Icon.astro';

interface Feature {
  title: string;
  description: string | string[];
}
interface Spec {
  label: string;
  values: string[];
  wide?: boolean;
}
interface UseCase {
  label: string;
  href: string;
}

interface MicroserviceGuide {
  href: string;
}

interface Props {
  title: string;
  shortName: string;
  heroDescription: string;
  heroDescriptionSecondary?: string;
  heroIcon?: string;
  features: Feature[];
  specs: Spec[];
  useCasesIcon?: string;
  useCases: UseCase[];
  hasDiagram?: boolean;
  hasDifferentiators?: boolean;
  microserviceGuide?: MicroserviceGuide;
}

const {
  title,
  shortName,
  heroDescription,
  heroDescriptionSecondary,
  heroIcon,
  features,
  specs,
  useCasesIcon,
  useCases,
  hasDiagram = false,
  hasDifferentiators = true,
  microserviceGuide,
} = Astro.props;

// Mini-syntaxe **gras** utilisée dans les descriptions de features (contenu de confiance, pas d'entrée utilisateur).
function bold(text: string) {
  return text.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
}
---

<BaseLayout title={title} description={heroDescription}>
  <section class="section product-hero">
    <div class="product-hero__inner">
      <div class="product-hero__text" data-reveal="left">
        <h1>{title}</h1>
        <p>{heroDescription}</p>
      </div>
      {
        heroIcon && (
          <div class="product-hero__icon" data-reveal="right">
            <img src={heroIcon} alt="" width="560" height="448" loading="lazy" />
          </div>
        )
      }
    </div>
  </section>

  {
    heroDescriptionSecondary && (
      <section class="section product-hero-secondary">
        <div class="container">
          <p data-reveal>{heroDescriptionSecondary}</p>
        </div>
      </section>
    )
  }

  <SectionDots count={3} active={2} />

  {
    features.length > 0 && (
      <section class="section product-features">
        <div class="container">
          <h2 class="product-section-title" data-reveal>Features &amp; Benefits</h2>
          <div class="product-features__list">
            {
              features.map((f) => (
                <div class="product-features__row" data-reveal>
                  <div class="product-features__label">
                    <h3>{f.title}</h3>
                    <span class="product-divider" />
                  </div>
                  {Array.isArray(f.description) ? (
                    <ul class="product-features__bullets">
                      {f.description.map((line) => (
                        <li set:html={bold(line)} />
                      ))}
                    </ul>
                  ) : (
                    <p set:html={bold(f.description)} />
                  )}
                </div>
              ))
            }
          </div>
        </div>
      </section>
    )
  }

  {
    hasDiagram && (
      <section class="section product-diagram-section">
        <div class="container">
          <slot name="diagram" />
        </div>
      </section>
    )
  }

  {
    hasDifferentiators && (
      <section class="section product-differentiators">
        <div class="container product-differentiators__inner" data-reveal>
          <slot />
        </div>
      </section>
    )
  }

  {
    specs.length > 0 && (
      <section class="section product-specs">
        <div class="container">
          <h2 class="product-section-title" data-reveal>Technical specifications</h2>
          <div class="product-specs__grid" data-reveal-group="scale">
            {
              specs.map((s) => (
                <div class="product-specs__item" data-wide={s.wide ? true : undefined}>
                  <h3>{s.label}</h3>
                  <span class="product-divider" />
                  {s.values.map((v) => (
                    <p>{v}</p>
                  ))}
                </div>
              ))
            }
          </div>
        </div>
      </section>
    )
  }

  {
    useCases.length > 0 && (
      <section class="section product-usecases">
        <div class="container product-usecases__inner">
          <div class="product-usecases__text" data-reveal="left">
            <h2>
              Check out some {shortName} use cases
            </h2>
            {
              useCases.length === 1 ? (
                <a href={useCases[0].href} class="btn btn--primary-bold">
                  Go to the use case page &gt;
                </a>
              ) : (
                <div class="product-usecases__list">
                  {useCases.map((u) => (
                    <a href={u.href} class="btn btn--primary-bold">
                      Go to {u.label} &gt;
                    </a>
                  ))}
                </div>
              )
            }
          </div>
          {useCasesIcon && (
            <div class="product-usecases__icon" data-reveal="right">
              <img src={useCasesIcon} alt="" width="200" height="200" loading="lazy" />
            </div>
          )}
        </div>
      </section>
    )
  }

  {
    microserviceGuide ? (
      <section class="section product-microservice-cta">
        <div class="container product-microservice-cta__inner">
          <div class="product-microservice-cta__text" data-reveal="left">
            <h2>Get the microservice guide</h2>
            <a href={microserviceGuide.href} class="btn btn--primary-bold">
              Contact us
            </a>
          </div>
          <div class="product-microservice-cta__icon" data-reveal="right">
            <Icon name="rocket-heptagon" size={200} />
          </div>
        </div>
      </section>
    ) : (
      <GetStartedSection icon="/images/products/slicce-icon-cloud.png" />
    )
  }
</BaseLayout>

<style>
  /* Hauteur fixe (comme sur le site original, ~360px sur toutes les pages
     sans distinction) : le texte est centré verticalement dedans plutôt
     que de dicter la hauteur du bandeau via son propre padding. */
  .product-hero {
    position: relative;
    background: var(--color-black-soft);
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: 360px;
    /* Annule le padding-block hérité de .section : la hauteur/le
       centrage sont désormais gérés ici et par .product-hero__inner. */
    padding-block: 0;
  }

  /* Texte + pod dans la même rangée flex (au lieu d'un pod positionné en
     absolu, ancré au bord de la fenêtre indépendamment du texte) : les
     deux se partagent l'espace sans jamais se chevaucher, quelle que
     soit la largeur de fenêtre. */
  .product-hero__inner {
    position: relative;
    width: 100%;
    max-width: 1600px;
    margin-inline: auto;
    padding-inline: var(--space-6);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
  }

  .product-hero__text {
    flex: 1 1 0;
    min-width: 0;
    max-width: 1100px;
  }

  .product-hero h1 {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 56px;
    color: var(--color-green);
    margin-bottom: var(--space-4);
  }

/*
  Interligne sous titre Features & Benefits
*/
  .product-section-title {
    text-align: center;
    margin-bottom: var(--space-16);
  }
/*
  Interligne sous bloc noir (header)
*/
  .product-features {
    padding-top: var(--space-12);
  }

/*
  Texte blanc bloc noir (header)
*/
  .product-hero__text p {
    font-family: var(--font-heading);
    font-size: 18.667px;
    font-weight: 400;
    color: var(--color-off-white);
    line-height: 1.5;
  }

/*
  Alignement droite pod bloc noir (header)
*/
  /* Le pod colle au haut et au bas du bandeau (comme sur le site
     original) : sa taille grossit/rétrécit avec la hauteur du bandeau,
     qui varie selon la longueur du titre/texte de chaque produit. */
  .product-hero__icon {
    flex: 0 0 auto;
    align-self: stretch;
    max-width: 450px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .product-hero__icon img {
    max-height: 100%;
    max-width: 100%;
    width: auto;
    height: auto;
  }
/*
  Lignes vertes Technical specifications
*/
  .product-divider {
    display: block;
    width: 64px;
    height: 3px;
    background: var(--color-green);
    margin-top: var(--space-2);
    margin-bottom: var(--space-3);
  }

/*
  Lignes vertes Features & Benefits
*/
  .product-features__label .product-divider {
    width: 100px;
    height: 5px;
  }

/*
  Marge et Interlignage entre bloc Features & Benefits
*/
  .product-features__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    padding-left: var(--space-24);
  }

/*
  Alignement gauche enumeration Features & Benefits
*/
  .product-features__row {
    display: grid;
    grid-template-columns: 340px 1fr;
    column-gap: 120px;
  }

/*
  Titre enumeration Features & Benefits
*/
  .product-features__label h3 {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 14.667px;
    color: var(--color-ink);
  }

/*
  Texte enumeration Features & Benefits
*/
  .product-features__row > p {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 14.667px;
    color: var(--color-ink);
    line-height: 1.6;
    max-width: 500px;
  }

/*
  Texte Bold enumeration Features & Benefits
*/
  .product-features__row > p :global(strong) {
    font-weight: 700;
  }

/*
  Liste à puces enumeration Features & Benefits (quand une feature a
  plusieurs points distincts plutôt qu'un paragraphe unique)
*/
  .product-features__bullets {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 14.667px;
    color: var(--color-ink);
    line-height: 1.6;
    max-width: 500px;
    margin: 0;
    padding-left: 1.1em;
  }

  .product-features__bullets li {
    margin-bottom: var(--space-2);
  }

  .product-features__bullets li:last-child {
    margin-bottom: 0;
  }

  .product-features__bullets :global(strong) {
    font-weight: 700;
  }

  .product-diagram-section {
    background: var(--color-section-gray);
  }

  .product-differentiators__inner {
    max-width: 1100px;
  }

  .product-differentiators__inner :global(p) {
    font-family: var(--font-sans);
    font-size: 14.667px;
    color: var(--color-ink);
    line-height: 1.7;
    margin-bottom: var(--space-6);
  }

  .product-specs__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-8);
  }

  .product-specs__item {
    min-height: 150px;
  }

  .product-specs__item[data-wide] {
    grid-column: span 2;
  }

  .product-specs__item h3 {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 14.667px;
    color: var(--color-ink);
  }

  .product-specs__item p {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 14.667px;
    color: var(--color-ink);
    line-height: 1.5;
    margin: 0;
    white-space: pre-line;
  }

  /*
    Suite du texte du hero (2e paragraphe), centrée en dessous du bandeau
    noir, juste au-dessus des SectionDots.
  */
  .product-hero-secondary {
    padding-bottom: 0;
  }

  .product-hero-secondary .container {
    max-width: 1050px;
  }

  .product-hero-secondary p {
    font-family: var(--font-heading);
    font-size: 18.667px;
    font-weight: 400;
    color: var(--color-ink);
    line-height: 1.5;
    text-align: center;
  }

  .product-microservice-cta {
    position: relative;
    background: var(--color-section-gray);
    overflow: visible;
  }

  .product-microservice-cta__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-12);
  }

  .product-microservice-cta__text h2 {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 42.667px;
    color: var(--color-ink);
    margin-bottom: var(--space-6);
  }

  .product-microservice-cta__icon {
    position: absolute;
    right: 0;
    bottom: -64px;
  }

  .product-usecases {
    background: var(--color-section-gray);
  }

  .product-usecases__inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-12);
  }

  .product-usecases__text h2 {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 42.667px;
    color: var(--color-ink);
    margin-bottom: var(--space-6);
  }

  .product-usecases__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .product-usecases__text .btn--primary-bold {
    font-size: 18px;
  }

  .product-usecases__icon {
    flex-shrink: 0;
    align-self: flex-end;
  }

  /* En dessous de cette largeur, l'icône (positionnée en pixels absolus)
     entre en collision avec le texte du hero avant même le point de bascule
     "mobile" — on la masque plus tôt et on repasse le titre en mode normal
     pour que ça reste correct sur tablette / fenêtre desktop réduite.
     Seuil resserré (était 1550px) : à l'origine masquait l'icône sur la
     plupart des écrans desktop courants (1440px, 1366px) alors que la
     majorité des titres produit n'entrent en collision qu'à des largeurs
     bien plus étroites. */
  @media (max-width: 1200px) {
    .product-hero__icon {
      display: none;
    }

    .product-hero h1 {
      font-size: 40px;
      white-space: normal;
    }
  }

  @media (max-width: 760px) {
    .product-usecases__inner,
    .product-microservice-cta__inner {
      flex-direction: column;
      align-items: flex-start;
      text-align: left;
      gap: var(--space-8);
    }

    /* Comme GetStartedSection : sur mobile, l'icône reste dans le flux
       normal (sous le texte) au lieu d'être positionnée en absolu, pour
       éviter tout chevauchement avec le texte au-dessus du footer. */
    .product-microservice-cta {
      padding-bottom: 0;
    }

    .product-microservice-cta__icon {
      position: static;
    }

    .product-hero h1 {
      font-size: 32px;
    }

    .product-hero__text p {
      font-size: 15px;
    }

    .product-features__list {
      padding-left: 0;
    }

    .product-features__row {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .product-specs__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .product-specs__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
